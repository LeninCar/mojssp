% Small test instance (3 jobs, 2 machines, 2 speeds) for MO-JSSP
% Total operations: 6

JOBS = 1..3;
MACHINES = 1..2;
SPEED = 2;

% Processing times [job, machine, speed]
time = array3d(
    JOBS,
    MACHINES,
    1..SPEED,
    [
        % Job 1: M1, M2
        4, 2,
        5, 3,

        % Job 2: M1, M2
        6, 4,
        3, 2,

        % Job 3: M1, M2
        5, 3,
        4, 2
    ]
);

% Energy consumption [job, machine, speed]
energy = array3d(
    JOBS,
    MACHINES,
    1..SPEED,
    [
        % Job 1: M1, M2
        12, 22,
        14, 26,

        % Job 2: M1, M2
        16, 28,
        10, 18,

        % Job 3: M1, M2
        15, 25,
        12, 20
    ]
);

% Precedence order within job [job, machine]
precedence = array2d(
    JOBS,
    MACHINES,
    [
        0, 1,
        1, 0,
        0, 1
    ]
);

% Release dates [job, machine]
releaseDate = array2d(
    JOBS,
    MACHINES,
    [
        0, 0,
        0, 0,
        1, 0
    ]
);

% Due dates [job, machine]
dueDate = array2d(
    JOBS,
    MACHINES,
    [
        15, 15,
        15, 15,
        18, 18
    ]
);
